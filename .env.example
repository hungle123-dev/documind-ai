# =============================================================
# DocChat — Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================

# ===== REQUIRED =====
GROQ_API_KEY=gsk-your-key-here         # Get from: https://console.groq.com/keys
# Optional multi-key fallback. If set, this takes priority over GROQ_API_KEY.
# GROQ_API_KEYS=gsk-key-1,gsk-key-2,gsk-key-3

# ===== MODELS (optional — defaults shown) =====
RELEVANCE_MODEL=llama-3.1-8b-instant       # Fast classification
RESEARCH_MODEL=llama-3.3-70b-versatile     # Strong generation quality
RESEARCH_FALLBACK_MODELS=["llama-3.1-8b-instant"]
VERIFICATION_MODEL=llama-3.1-8b-instant     # Structured fact-check

# ===== EMBEDDING (optional) =====
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # Multilingual EN+VI, 118MB

# ===== RETRIEVAL TUNING (optional) =====
VECTOR_SEARCH_K=15
RERANKER_TOP_N=5

# ===== SERVER (optional) =====
SERVER_HOST=0.0.0.0
SERVER_PORT=7860
