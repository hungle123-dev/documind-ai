# =============================================================
# DocChat — Environment Variables Template
# Copy this file to .env and fill in your values
# =============================================================

# ===== REQUIRED =====
XAI_API_KEY=xai-your-key-here          # Get from: https://console.x.ai/

# ===== MODELS (optional — defaults shown) =====
RELEVANCE_MODEL=grok-3-mini-fast       # Fast classification
RESEARCH_MODEL=grok-3                  # Best generation quality
VERIFICATION_MODEL=grok-3-mini         # Structured fact-check

# ===== EMBEDDING (optional) =====
EMBEDDING_MODEL=intfloat/multilingual-e5-small   # Multilingual EN+VI, 118MB

# ===== RETRIEVAL TUNING (optional) =====
VECTOR_SEARCH_K=15
RERANKER_TOP_N=5

# ===== SERVER (optional) =====
SERVER_HOST=0.0.0.0
SERVER_PORT=7860
